# Copy to `.env.azure.local` (ignored by git) to run against Azure Fluid Relay
# with `npm run dev:azure`. Leave unset to use the local Tinylicious service.

# "azure" connects to Azure Fluid Relay. Any other value, or unset, is local.
VITE_FLUID_CLIENT=azure

# From the Access Keys blade of the Fluid Relay resource, or `AZURE.local.md`.
VITE_FLUID_TENANT_ID=
VITE_FLUID_ENDPOINT=https://us.fluidrelay.azure.com

# The tenant key. This goes into the browser bundle, so this mode is for
# trying the relay only, not for anything shared.
VITE_FLUID_TENANT_KEY=
